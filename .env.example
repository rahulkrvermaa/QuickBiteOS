# QuickBite OS — Production Environment Configuration
# Set these environment variables in your deployment dashboard (e.g. Vercel, Netlify, Cloudflare Pages)

# Frontend Public Variables
VITE_APP_NAME="QuickBite OS"
VITE_APP_URL="https://yourdomain.com"

# Supabase (Public safe keys ONLY - never add service_role key to frontend)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Razorpay (Public Key ID for client checkout popup)
VITE_RAZORPAY_KEY_ID="rzp_live_or_test_key_id"
